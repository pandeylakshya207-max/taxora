// Taxora database schema — Phase 1: firms, users, sessions, clients, audit log.
//
// Rules this schema enforces:
// - Every business record belongs to exactly one Firm (tenant isolation).
// - Uniqueness rules live in the database, not just in the UI.
// - Audit rows are append-only by convention (no update/delete code paths).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// What kind of organisation the workspace belongs to.
enum OrgKind {
  CA_PRACTICE
  COMPANY
  INDIVIDUAL
}

enum OtpPurpose {
  EMAIL_VERIFICATION
}

enum ReconStatus {
  DRAFT
  COMPLETED
  FAILED
}

enum SourceKind {
  PURCHASE_REGISTER
  GSTR2B
}

enum DocKind {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FollowUpStatus {
  DRAFT
  SENT
  RESOLVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

/// Where a task's due date came from. Taxora never invents statutory dates.
enum DueDateSource {
  RULE
  MANUAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  TRUST
  OTHER
}

/// A workspace: a CA practice, a company's finance team, or an individual professional.
/// (Named Firm in the database; shown as "workspace" in the UI.)
model Firm {
  id          String       @id @default(cuid())
  name        String
  kind        OrgKind      @default(CA_PRACTICE)
  /// Workspace matching thresholds; read through resolveReconConfig().
  reconConfig Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  clients     Client[]
  sessions    Session[]
  auditLogs   AuditLog[]
  reconciliations Reconciliation[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique // stored lower-cased
  name         String
  passwordHash String
  /// Null until the user enters a valid OTP sent to this email.
  emailVerifiedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
  clientsMade  Client[]     @relation("ClientCreatedBy")
  auditLogs    AuditLog[]
  otps         EmailOtp[]
  reconciliations Reconciliation[]
}

/// One-time codes. Only a hash of the code is stored. A code is single-use,
/// expires after 10 minutes and locks after 5 wrong attempts.
model EmailOtp {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  firmId    String
  userId    String
  role      Role     @default(MEMBER)
  /// Notification kinds this member chose not to receive in-app.
  mutedNotifications String[] @default([])
  createdAt DateTime @default(now())
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([firmId, userId])
  @@index([userId])
}

/// Server-side session. Only a SHA-256 hash of the cookie token is stored,
/// so a database leak does not leak usable session cookies.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  firmId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id           String        @id @default(cuid())
  firmId       String
  name         String
  gstin        String? // normalised upper-case; null for unregistered clients
  contactName  String?
  email        String?
  phone        String?
  businessType BusinessType?
  stateCode    String? // derived from GSTIN when present
  status       ClientStatus  @default(ACTIVE)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?
  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reconciliations Reconciliation[]

  // One firm cannot hold the same GSTIN twice. Postgres allows many NULLs,
  // so unregistered clients without a GSTIN are not blocked by this.
  @@unique([firmId, gstin])
  @@index([firmId, status, name])
}

/// Append-only record of who did what, when. Never updated or deleted by app code.
model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  actorId    String?
  action     String // e.g. "client.created", "client.archived"
  entityType String // e.g. "Client"
  entityId   String?
  details    Json?
  requestId  String?
  createdAt  DateTime @default(now())
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
  @@index([firmId, entityType, entityId])
}

/// One reconciliation of a client's purchase register against GSTR-2B for a tax period.
/// A client can have several runs for the same period (e.g. after correcting a file).
model Reconciliation {
  id          String       @id @default(cuid())
  firmId      String
  clientId    String
  period      String // "YYYY-MM"
  status      ReconStatus  @default(DRAFT)
  /// Engine thresholds used for this run, saved so results stay explainable later.
  config      Json?
  /// Counts derived from MatchResult rows at completion time.
  summary     Json?
  error       String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?
  /// Set once by an authorised user after review. Results are read-only afterwards.
  finalizedAt   DateTime?
  finalizedById String?
  finalNote     String?
  firm        Firm         @relation(fields: [firmId], references: [id], onDelete: Restrict)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  files       ImportFile[]
  rows        InvoiceRow[]
  results     MatchResult[]

  @@index([firmId, createdAt])
  @@index([firmId, clientId, period])
}

/// The uploaded file (kept, so the column mapping can be corrected and re-applied
/// without uploading again) plus what the import found in it.
model ImportFile {
  id               String         @id @default(cuid())
  firmId           String
  reconciliationId String
  source           SourceKind
  fileName         String
  fileSize         Int
  sha256           String
  content          Bytes
  sheetName        String?
  headerRowIndex   Int
  dataStartIndex   Int
  headers          Json
  mapping          Json
  stats            Json
  /// Row-level problems, capped for storage; stats hold the full counts.
  errors           Json
  warnings         Json
  uploadedById     String
  createdAt        DateTime       @default(now())
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  rows             InvoiceRow[]

  @@unique([reconciliationId, source])
  @@index([firmId, sha256])
}

/// One validated invoice line. Amounts are integer paise (BigInt) — exact, never floating point.
model InvoiceRow {
  id               String         @id @default(cuid())
  firmId           String
  reconciliationId String
  importFileId     String
  source           SourceKind
  sourceRow        Int
  gstin            String
  supplierName     String?
  invoiceNo        String
  invoiceDate      String? // ISO YYYY-MM-DD
  docType          DocKind
  taxable          BigInt
  igst             BigInt
  cgst             BigInt
  sgst             BigInt
  cess             BigInt
  /// Cell text exactly as uploaded, for audit.
  original         Json
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  importFile       ImportFile     @relation(fields: [importFileId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, source])
  @@index([firmId, gstin])
}

/// One engine result. Every imported row appears in exactly one result per run.
model MatchResult {
  id               String         @id @default(cuid())
  firmId           String
  reconciliationId String
  category         String
  prRowId          String?
  b2bRowId         String?
  flags            String[]
  reasons          String[]
  needsReview      Boolean
  score            Json?
  diffs            Json?
  relatedIds       String[]
  reviewStatus     ReviewStatus   @default(PENDING)
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, category])
  @@index([reconciliationId, needsReview])
}

/// A supplier follow-up email drafted in Taxora. Taxora does not send it:
/// SENT means a user confirmed they sent it themselves, outside Taxora.
model FollowUp {
  id             String         @id @default(cuid())
  firmId         String
  clientId       String
  supplierGstin  String
  periodLabel    String
  matchResultIds String[]
  subject        String
  body           String
  status         FollowUpStatus @default(DRAFT)
  note           String?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([firmId, supplierGstin])
  @@index([firmId, clientId])
}

/// A recurring due-date rule the workspace defines, with the source it was taken from.
model DueDateRule {
  id          String   @id @default(cuid())
  firmId      String
  label       String // e.g. "GSTR-3B (monthly)"
  dayOfMonth  Int
  monthOffset Int // 1 = month after the tax period
  sourceNote  String // where the user got this date, e.g. a notification number
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       ComplianceTask[]

  @@index([firmId, active])
}

model ComplianceTask {
  id               String        @id @default(cuid())
  firmId           String
  clientId         String?
  title            String
  period           String? // "YYYY-MM"
  dueDate          String // "YYYY-MM-DD", IST
  dueDateSource    DueDateSource
  sourceNote       String?
  ruleId           String?
  status           TaskStatus    @default(TODO)
  notes            String?
  reconciliationId String?
  createdById      String
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  rule             DueDateRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  /// Generating from a rule twice for the same client and period is a no-op.
  @@unique([firmId, ruleId, clientId, period])
  @@index([firmId, status, dueDate])
  @@index([firmId, clientId])
}

/// In-app notification for one user. Read state is per user and persists.
model Notification {
  id        String    @id @default(cuid())
  firmId    String
  userId    String
  kind      String // e.g. "reconciliation.completed"
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, firmId, readAt, createdAt])
}

/// Support request. `number` is a real database sequence, so every reference
/// shown to a user (TX-000123) corresponds to a stored ticket.
model SupportTicket {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  firmId      String
  userId      String
  subject     String
  category    String
  priority    TicketPriority  @default(NORMAL)
  description String
  status      TicketStatus    @default(OPEN)
  /// Whether a copy was accepted by the configured support mailbox (null = not configured).
  emailedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    SupportMessage[]

  @@index([firmId, createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// A stored, schema-validated AI suggestion. Kept so it can be shown again
/// without another call, and so it is clear which model produced it and when.
model AiInsight {
  id          String   @id @default(cuid())
  firmId      String
  scope       String // "result" | "reconciliation"
  targetId    String
  model       String
  output      Json
  createdById String
  createdAt   DateTime @default(now())

  @@index([firmId, scope, targetId, createdAt])
  @@index([firmId, createdAt])
}

enum AutomationKind {
  COMPLIANCE_REMINDERS
  REVIEW_PENDING
  REPEATED_MISSING
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum RunTrigger {
  SCHEDULE
  MANUAL
  RETRY
}

/// A workspace's settings for one built-in automation. Created the first time
/// someone saves it; names and descriptions live in code.
model Automation {
  id                  String          @id @default(cuid())
  firmId              String
  kind                AutomationKind
  enabled             Boolean         @default(false)
  config              Json
  /// Daily run time, whole hour in IST (0–23).
  runHour             Int
  nextRunAt           DateTime?
  lastRunAt           DateTime?
  lastStatus          RunStatus?
  consecutiveFailures Int             @default(0)
  updatedById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  runs                AutomationRun[]
  alerts              AutomationAlert[]

  @@unique([firmId, kind])
  @@index([enabled, nextRunAt])
}

/// One execution, scheduled or manual, with its outcome.
model AutomationRun {
  id            String     @id @default(cuid())
  firmId        String
  automationId  String
  trigger       RunTrigger
  status        RunStatus  @default(RUNNING)
  /// 1 for a first try; 2+ for consecutive automatic retries.
  attempt       Int        @default(1)
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  /// What the run found and did (counts, items notified).
  result        Json?
  /// Short error message only — never a stack trace or secret.
  error         String?
  triggeredById String?
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, startedAt])
  @@index([firmId, startedAt])
}

/// Remembers what an automation already alerted about, so nothing is raised twice.
model AutomationAlert {
  id           String     @id @default(cuid())
  automationId String
  dedupeKey    String
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, dedupeKey])
}

/// Each authorised call to the scheduler endpoint, so the app can show whether
/// the scheduler is actually running.
model CronTick {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  finishedAt DateTime?
  processed Int       @default(0)
  failed    Int       @default(0)

  @@index([startedAt])
}
